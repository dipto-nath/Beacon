# Database
DATABASE_URL=postgresql+asyncpg://beacon:beacon@localhost:5432/beacon
DATABASE_URL_SYNC=postgresql://beacon:beacon@localhost:5432/beacon

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET_KEY=dev-secret-key-min-64-characters-long-for-development-only-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Field Encryption (base64 encoded 32 bytes)
FIELD_ENCRYPTION_KEY=ZGV2LWVuY3J5cHRpb24ta2V5LTMyLWJ5dGVzLWxvbmc=

# OpenAI
OPENAI_API_KEY=sk-dev
OPENAI_MODEL=gpt-4o

# Email
SENDGRID_API_KEY=SG.dev
EMAIL_FROM=no-reply@beacon.ashford.ac.uk
EMAIL_FROM_NAME=Beacon Wellbeing

# Privacy & Escalation
K_ANONYMITY_THRESHOLD=10
ESCALATION_THRESHOLD_SINGLE=0.75
ESCALATION_THRESHOLD_CONSECUTIVE=0.60
CONSECUTIVE_DAYS_FOR_ESCALATION=3

# App
ENVIRONMENT=development
DEBUG=true
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Rate Limiting
RATE_LIMIT_LOGIN=5
RATE_LIMIT_LOGIN_WINDOW=900
RATE_LIMIT_CHECK_IN=10
RATE_LIMIT_CHECK_IN_WINDOW=60
RATE_LIMIT_API=100
RATE_LIMIT_API_WINDOW=60

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json
CELERY_ACCEPT_CONTENT=json
CELERY_TIMEZONE=UTC
CELERY_BEAT_SCHEDULE_FILE=./celerybeat-schedule

# File Storage
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=./storage/exports
