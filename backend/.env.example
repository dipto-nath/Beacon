# Database
DATABASE_URL=postgresql+asyncpg://beacon:beacon@localhost:5432/beacon
DATABASE_URL_SYNC=postgresql://beacon:beacon@localhost:5432/beacon

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET_KEY=your-super-secret-jwt-key-min-64-chars-long-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Field Encryption (AES-256 key, base64 encoded)
FIELD_ENCRYPTION_KEY=your-base64-encoded-32-byte-key-here

# OpenAI (for recommendation personalization)
OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-4o

# Email (SendGrid)
SENDGRID_API_KEY=SG.your-sendgrid-key
EMAIL_FROM=no-reply@beacon.ashford.ac.uk
EMAIL_FROM_NAME=Beacon Wellbeing

# SAML SSO (optional - for university integration)
SAML_IDP_METADATA_URL=https://sso.ashford.ac.uk/metadata
SAML_SP_ENTITY_ID=https://beacon.ashford.ac.uk
SAML_SP_ACS_URL=https://beacon.ashford.ac.uk/auth/sso/callback
SAML_SP_SLS_URL=https://beacon.ashford.ac.uk/auth/sso/logout
SAML_CERT_PATH=./certs/saml.crt
SAML_KEY_PATH=./certs/saml.key

# Privacy & Escalation Thresholds
K_ANONYMITY_THRESHOLD=10
ESCALATION_THRESHOLD_SINGLE=0.75
ESCALATION_THRESHOLD_CONSECUTIVE=0.60
CONSECUTIVE_DAYS_FOR_ESCALATION=3

# App
ENVIRONMENT=development
DEBUG=true
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,https://beacon.ashford.ac.uk

# Rate Limiting
RATE_LIMIT_LOGIN=5
RATE_LIMIT_LOGIN_WINDOW=900
RATE_LIMIT_CHECK_IN=10
RATE_LIMIT_CHECK_IN_WINDOW=60
RATE_LIMIT_API=100
RATE_LIMIT_API_WINDOW=60

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json
CELERY_ACCEPT_CONTENT=json
CELERY_TIMEZONE=UTC
CELERY_BEAT_SCHEDULE_FILE=./celerybeat-schedule

# File Storage (for exports)
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=./storage/exports
AWS_S3_BUCKET=beacon-exports
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json